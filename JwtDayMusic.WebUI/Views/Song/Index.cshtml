@model List<JwtDayMusic.WebUI.Dtos.ResultSongDto>

@{
    ViewData["Title"] = "Müzikler";

    // Kademe (Tier) sayısını okunur etikete çeviren yardımcı.
    string TierName(int t) => t switch
    {
        1 => "Basic",
        2 => "Gold",
        3 => "Premium",
        4 => "Elit",
        _ => "Basic"
    };
}

<section class="mg-section">
    <div class="mg-hero-head">
        <h2 class="mg-heading mg-heading--secondary">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
            Senin için önerilenler
        </h2>
        <div class="mg-hero-nav">
            <button type="button" class="mg-hero-nav-btn" id="recPrevBtn" aria-label="Önceki">
                <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <button type="button" class="mg-hero-nav-btn" id="recNextBtn" aria-label="Sonraki">
                <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>
    </div>
    <div id="recommendations" class="mb-4">
        <p class="text-muted">Öneriler yükleniyor...</p>
    </div>
</section>

<section class="mg-section">
    <h2 class="mg-heading mg-heading--primary">
        <span class="material-symbols-outlined">grid_view</span>
        Keşfet
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Henüz şarkı bulunmuyor.</div>
    }
    else
    {
        <div class="mg-grid">
            @foreach (var song in Model)
            {
                <div class="mg-card mg-card--tier-@song.Tier">
                    <div class="mg-card-cover">
                        <img src="@song.CoverImageUrl" alt="@song.Title" />
                        <div class="mg-card-play-overlay">
                            <button class="mg-card-play queue-item"
                                    data-song-id="@song.SongId"
                                    data-song-title="@song.Title"
                                    data-song-artist="@song.ArtistName"
                                    onclick="player.playFrom(@song.SongId)"
                                    title="Oynat">
                                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                            </button>
                        </div>
                    </div>
                    <div class="mg-card-title-row">
                        <h4 class="mg-card-title">@song.Title</h4>
                        <span class="mg-badge">@TierName(song.Tier)</span>
                    </div>
                    <p class="mg-card-artist">@song.ArtistName</p>
                    <div class="mg-card-actions">
                        <button class="mg-icon-btn like-btn text-muted" data-song-id="@song.SongId"
                                onclick="toggleLike(@song.SongId, this)" title="Beğen">♡</button>
                        <button class="mg-icon-btn" onclick="addToPlaylist(@song.SongId)" title="Playlist'e ekle">
                            <span class="material-symbols-outlined">playlist_add</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</section>
@section Scripts {
    <script>
        // Sayfa yüklenince önerileri arkadan çek ve yerleştir.
        window.addEventListener('DOMContentLoaded', async function () {
            try {
                const res = await fetch('/Song/Recommendations');
                const html = await res.text();
                document.getElementById('recommendations').innerHTML = html;
                initHeroScrollNav('recommendations', 'recPrevBtn', 'recNextBtn');
            } catch (e) {
                document.getElementById('recommendations').innerHTML =
                    '<p class="text-muted">Öneriler yüklenemedi.</p>';
            }
        });

        // Yatay kaydırmalı öneri şeridini ileri/geri oklarla kaydırır;
        // baştaysa geri, sondaysa ileri okunu pasifleştirir.
        function initHeroScrollNav(containerId, prevId, nextId) {
            const strip = document.querySelector('#' + containerId + ' .mg-hero-strip');
            const prevBtn = document.getElementById(prevId);
            const nextBtn = document.getElementById(nextId);
            if (!strip || !prevBtn || !nextBtn) {
                if (prevBtn) prevBtn.style.display = 'none';
                if (nextBtn) nextBtn.style.display = 'none';
                return;
            }
            function updateNavState() {
                prevBtn.disabled = strip.scrollLeft <= 4;
                nextBtn.disabled = strip.scrollLeft >= strip.scrollWidth - strip.clientWidth - 4;
            }
            strip.addEventListener('scroll', updateNavState);
            window.addEventListener('resize', updateNavState);
            prevBtn.addEventListener('click', () => strip.scrollBy({ left: -360, behavior: 'smooth' }));
            nextBtn.addEventListener('click', () => strip.scrollBy({ left: 360, behavior: 'smooth' }));
            updateNavState();
        }
    </script>
}
