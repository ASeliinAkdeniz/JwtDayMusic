
@{
    Layout = null;
    ViewData["Title"] = "Access Denied – SoundWave";

    // Bu değerleri controller'dan ViewBag/ViewData ile doldurabilirsiniz
    // Örnek: ViewBag.UserPlan = "Gold"; ViewBag.RequiredPlan = "Premium";
    var userPlan = ViewBag.UserPlan as string ?? "Gold";
    var requiredPlan = ViewBag.RequiredPlan as string ?? "Premium";
    var userName = ViewBag.UserName as string ?? "Alex";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg-base: #06060f;
            --bg-surface: #0d0d1c;
            --bg-card: rgba(14,14,28,0.85);
            --glass-border: rgba(255,255,255,0.07);
            --accent-cyan: #00e5ff;
            --accent-violet: #7c3aed;
            --accent-pink: #f72585;
            --accent-lime: #c8ff57;
            --accent-gold: #f5a623;
            --accent-amber: #fbbf24;
            /* Plan renkleri */
            --plan-elite: linear-gradient(135deg, #00e5ff, #7c3aed);
            --plan-premium: linear-gradient(135deg, #f5a623, #f72585);
            --plan-gold: linear-gradient(135deg, #fbbf24, #d97706);
            --text-primary: #f0f0ff;
            --text-secondary: #8888aa;
            --text-muted: #44445a;
            --radius-card: 22px;
            --radius-pill: 50px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100%;
            font-family: 'DM Sans', sans-serif;
            background: var(--bg-base);
            color: var(--text-primary);
            overflow-x: hidden;
        }

        /* ── AMBIENT BACKGROUND ── */
        .ambient {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
        }

            .ambient::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 50% at 15% 20%, rgba(247,37,133,0.15) 0%, transparent 55%), radial-gradient(ellipse 50% 60% at 85% 70%, rgba(124,58,237,0.2) 0%, transparent 55%), radial-gradient(ellipse 40% 35% at 50% 50%, rgba(245,166,35,0.08) 0%, transparent 50%);
            }

            .ambient::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
                opacity: .4;
            }

        /* ── NAVBAR ── */
        nav {
            position: relative;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 clamp(1.5rem, 5vw, 3.5rem);
            height: 68px;
            background: rgba(6,6,15,0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .nav-logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: #fff;
            box-shadow: 0 0 20px rgba(0,229,255,0.35);
        }

        .nav-logo-text {
            font-family: 'Syne', sans-serif;
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: -0.4px;
            background: linear-gradient(90deg, var(--accent-cyan), var(--accent-violet));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-plan-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 4px 12px;
            border-radius: var(--radius-pill);
        }

        .badge-gold {
            background: rgba(251,191,36,0.12);
            border: 1px solid rgba(251,191,36,0.3);
            color: var(--accent-amber);
        }

        .badge-elite {
            background: rgba(0,229,255,0.1);
            border: 1px solid rgba(0,229,255,0.25);
            color: var(--accent-cyan);
        }

        .badge-premium {
            background: rgba(245,166,35,0.12);
            border: 1px solid rgba(245,166,35,0.3);
            color: var(--accent-gold);
        }

        .nav-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent-violet), var(--accent-pink));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            color: #fff;
            border: 2px solid rgba(255,255,255,0.1);
        }

        /* ── PAGE WRAPPER ── */
        .page-wrapper {
            position: relative;
            z-index: 1;
            min-height: calc(100vh - 68px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem clamp(1rem, 4vw, 2rem);
        }

        .content-col {
            width: 100%;
            max-width: 900px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2rem;
        }

        /* ── 403 HERO ── */
        .error-hero {
            text-align: center;
        }

        .lock-ring {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 2rem;
        }
            /* spinning gradient halo */
            .lock-ring::before {
                content: '';
                position: absolute;
                inset: -10px;
                border-radius: 50%;
                background: conic-gradient( from 0deg, rgba(247,37,133,0.6), rgba(124,58,237,0.5), rgba(245,166,35,0.4), rgba(247,37,133,0.6) );
                animation: spin 4s linear infinite;
                filter: blur(8px);
            }
        @@keyframes spin {
            to

        {
            transform: rotate(360deg);
        }

        }

        .lock-circle {
            position: relative;
            z-index: 1;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(14,14,28,0.9);
            border: 1px solid rgba(247,37,133,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.8rem;
            box-shadow: 0 0 0 1px rgba(255,255,255,0.05), inset 0 0 40px rgba(247,37,133,0.08);
            animation: lockPulse 3s ease-in-out infinite;
        }
        @@keyframes lockPulse {
            0%, 100%

        {
            box-shadow: 0 0 0 1px rgba(255,255,255,0.05), 0 0 30px rgba(247,37,133,0.2);
        }

        50% {
            box-shadow: 0 0 0 1px rgba(255,255,255,0.05), 0 0 55px rgba(247,37,133,0.4);
        }

        }

        .error-code {
            font-family: 'Syne', sans-serif;
            font-size: clamp(5rem, 14vw, 9rem);
            font-weight: 800;
            letter-spacing: -6px;
            line-height: 1;
            background: linear-gradient(135deg, var(--accent-pink) 0%, var(--accent-violet) 50%, var(--accent-gold) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            position: relative;
        }
            /* glitch layers */
            .error-code::before,
            .error-code::after {
                content: '403';
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: inherit;
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .error-code::before {
                animation: glitchTop 4s infinite;
                clip-path: polygon(0 0, 100% 0, 100% 33%, 0 33%);
                opacity: 0.6;
            }

            .error-code::after {
                animation: glitchBot 4s infinite 0.1s;
                clip-path: polygon(0 66%, 100% 66%, 100% 100%, 0 100%);
                opacity: 0.4;
            }
        @@keyframes glitchTop {
            0%,90%,100%

        {
            transform: translate(0);
        }

        92% {
            transform: translate(-3px, -1px);
        }

        94% {
            transform: translate(3px, 0);
        }

        96% {
            transform: translate(-2px, 1px);
        }

        }
        @@keyframes glitchBot {
            0%,90%,100%

        {
            transform: translate(0);
        }

        93% {
            transform: translate(3px, 1px);
        }

        95% {
            transform: translate(-3px, -1px);
        }

        97% {
            transform: translate(2px, 0);
        }

        }

        .error-tag {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--accent-pink);
            background: rgba(247,37,133,0.1);
            border: 1px solid rgba(247,37,133,0.25);
            border-radius: var(--radius-pill);
            padding: 5px 16px;
            margin-bottom: 1.2rem;
        }

        .error-title {
            font-family: 'Syne', sans-serif;
            font-size: clamp(1.6rem, 4vw, 2.4rem);
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 0.9rem;
        }

        .error-desc {
            color: var(--text-secondary);
            font-size: 0.95rem;
            font-weight: 300;
            line-height: 1.75;
            max-width: 480px;
            margin: 0 auto;
        }

        /* ── ACCESS INFO CARD ── */
        .access-card {
            width: 100%;
            background: var(--bg-card);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-card);
            padding: 1.75rem 2rem;
            backdrop-filter: blur(30px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
        }

            .access-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 8%;
                right: 8%;
                height: 1px;
                background: linear-gradient(90deg, transparent, var(--accent-pink), var(--accent-violet), transparent);
            }

        .access-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 1.5rem;
        }

        /* User's current plan */
        .plan-block {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .plan-label {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
        }

        .plan-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 18px;
            border-radius: var(--radius-pill);
            font-family: 'Syne', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .chip-gold {
            background: rgba(251,191,36,0.12);
            border: 1.5px solid rgba(251,191,36,0.35);
            color: var(--accent-amber);
        }

        .chip-elite {
            background: rgba(0,229,255,0.1);
            border: 1.5px solid rgba(0,229,255,0.3);
            color: var(--accent-cyan);
        }

        .chip-premium {
            background: rgba(245,166,35,0.12);
            border: 1.5px solid rgba(245,166,35,0.35);
            color: var(--accent-gold);
        }

        .plan-perks {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 4px;
        }

        .perk-item {
            font-size: 0.75rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .perk-item i {
                font-size: 0.65rem;
            }

        .perk-ok {
            color: #4ade80;
        }

        .perk-no {
            color: var(--accent-pink);
        }

        /* Arrow divider */
        .plan-arrow {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
        }

        .arrow-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(247,37,133,0.08);
            border: 1px solid rgba(247,37,133,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: var(--accent-pink);
        }

        .arrow-text {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* Required plan */
        .required-block {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .required-glow {
            box-shadow: 0 0 24px rgba(245,166,35,0.3);
            animation: reqPulse 2.5s ease-in-out infinite;
        }
        @@keyframes reqPulse {
            0%,100%

        {
            box-shadow: 0 0 20px rgba(245,166,35,0.25);
        }

        50% {
            box-shadow: 0 0 40px rgba(245,166,35,0.5);
        }

        }

        /* ── PLAN COMPARISON TABLE ── */
        .compare-card {
            width: 100%;
            background: var(--bg-card);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-card);
            padding: 1.75rem 2rem;
            backdrop-filter: blur(30px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
        }

            .compare-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 8%;
                right: 8%;
                height: 1px;
                background: linear-gradient(90deg, transparent, var(--accent-violet), var(--accent-cyan), transparent);
            }

        .compare-title {
            font-family: 'Syne', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: -0.3px;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .compare-title i {
                color: var(--accent-cyan);
            }

        .plan-cards-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .plan-card {
            border-radius: 16px;
            border: 1.5px solid transparent;
            padding: 1.25rem 1rem;
            text-align: center;
            position: relative;
            transition: transform 0.25s;
            cursor: default;
        }

            .plan-card:hover {
                transform: translateY(-4px);
            }

        .plan-card-gold {
            background: rgba(251,191,36,0.05);
            border-color: rgba(251,191,36,0.2);
        }

        .plan-card-premium {
            background: rgba(245,166,35,0.07);
            border-color: rgba(245,166,35,0.35);
            box-shadow: 0 0 30px rgba(245,166,35,0.15);
        }

        .plan-card-elite {
            background: rgba(0,229,255,0.05);
            border-color: rgba(0,229,255,0.2);
        }

        /* "Required" badge on premium card */
        .required-badge {
            position: absolute;
            top: -11px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            padding: 3px 12px;
            border-radius: var(--radius-pill);
            background: linear-gradient(135deg, var(--accent-gold), var(--accent-pink));
            color: #fff;
            white-space: nowrap;
        }

        /* "Your Plan" badge */
        .your-badge {
            position: absolute;
            top: -11px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            padding: 3px 12px;
            border-radius: var(--radius-pill);
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.15);
            color: var(--text-secondary);
            white-space: nowrap;
        }

        .pc-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin: 0 auto 0.75rem;
        }

        .pc-icon-gold {
            background: rgba(251,191,36,0.12);
        }

        .pc-icon-premium {
            background: rgba(245,166,35,0.15);
        }

        .pc-icon-elite {
            background: rgba(0,229,255,0.1);
        }

        .pc-name {
            font-family: 'Syne', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .pc-price {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 0.85rem;
        }

            .pc-price strong {
                font-size: 1.1rem;
                font-weight: 700;
            }

        .pc-features {
            list-style: none;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .pc-features li {
                font-size: 0.73rem;
                color: var(--text-secondary);
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .pc-features li i {
                    font-size: 0.6rem;
                    flex-shrink: 0;
                }

        .fi-yes {
            color: #4ade80;
        }

        .fi-no {
            color: var(--text-muted);
        }

        .fi-lock {
            color: var(--accent-pink);
        }

        /* ── CTA BUTTONS ── */
        .cta-row {
            display: flex;
            gap: 0.85rem;
            flex-wrap: wrap;
            justify-content: center;
            width: 100%;
        }

        .btn-upgrade {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, var(--accent-gold), var(--accent-pink));
            color: #fff;
            border: none;
            border-radius: var(--radius-pill);
            padding: 0.85rem 2rem;
            font-family: 'Syne', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: transform 0.25s, box-shadow 0.25s;
            box-shadow: 0 6px 24px rgba(245,166,35,0.3);
            text-decoration: none;
        }

            .btn-upgrade:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 36px rgba(245,166,35,0.45);
                color: #fff;
            }

            .btn-upgrade .btn-arrow {
                transition: transform 0.25s;
            }

            .btn-upgrade:hover .btn-arrow {
                transform: translateX(3px);
            }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-secondary);
            border-radius: var(--radius-pill);
            padding: 0.85rem 1.75rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }

            .btn-back:hover {
                background: rgba(255,255,255,0.09);
                color: var(--text-primary);
            }

        /* ── RESPONSIVE ── */
        @@media (max-width: 700px) {
            .access-row {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .plan-arrow {
                flex-direction: row;
                justify-content: center;
            }

            .plan-cards-grid {
                grid-template-columns: 1fr;
            }

            .plan-card {
                margin-top: 14px;
            }
        }

        @@media (max-width: 480px) {
            .compare-card, .access-card {
                padding: 1.25rem 1rem;
            }
        }
    </style>
</head>
<body>

    <div class="ambient"></div>

    <!-- ── NAVBAR ── -->
    <nav>
        <a href="/" class="nav-logo">
            <div class="nav-logo-icon"><i class="bi bi-soundwave"></i></div>
            <span class="nav-logo-text">SoundWave</span>
        </a>
        <div class="nav-right">
            @{
                var badgeClass = userPlan.ToLower() switch
                {
                    "elite" => "badge-elite",
                    "premium" => "badge-premium",
                    _ => "badge-gold"
                };
                var badgeIcon = userPlan.ToLower() switch
                {
                    "elite" => "bi-stars",
                    "premium" => "bi-gem",
                    _ => "bi-award"
                };
            }
            <span class="nav-plan-badge @badgeClass">
                <i class="bi @badgeIcon"></i> @userPlan
            </span>
            <div class="nav-avatar">@(userName.Length > 0 ? userName[0].ToString().ToUpper() : "U")</div>
        </div>
    </nav>

    <!-- ── PAGE ── -->
    <div class="page-wrapper">
        <div class="content-col">

            <!-- 403 Hero -->
            <div class="error-hero">
                <div class="lock-ring">
                    <div class="lock-circle">🔒</div>
                </div>
                <div class="error-code">403</div>
                <div class="error-tag"><i class="bi bi-shield-x"></i> Access Denied</div>
                <h1 class="error-title">This content requires <br><span style="background:linear-gradient(135deg,var(--accent-gold),var(--accent-pink));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">@requiredPlan Plan</span></h1>
                <p class="error-desc">
                    Hey <strong>@userName</strong>, your current <strong>@userPlan</strong> plan doesn't include access to this feature.
                    Upgrade to <strong>@requiredPlan</strong> to unlock exclusive content, HD audio, and much more.
                </p>
            </div>

            <!-- Access Info Card -->
            <div class="access-card">
                <div class="access-row">

                    <!-- Current plan -->
                    <div class="plan-block">
                        <span class="plan-label"><i class="bi bi-person-circle"></i> Your current plan</span>
                        @{
                            var currentChipClass = userPlan.ToLower() switch
                            {
                                "elite" => "chip-elite",
                                "premium" => "chip-premium",
                                _ => "chip-gold"
                            };
                            var currentIcon = userPlan.ToLower() switch
                            {
                                "elite" => "⚡",
                                "premium" => "💎",
                                _ => "🥇"
                            };
                        }
                        <span class="plan-chip @currentChipClass">@currentIcon @userPlan</span>
                        <div class="plan-perks">
                            <div class="perk-item"><i class="bi bi-check-circle-fill perk-ok"></i> Standard audio quality</div>
                            <div class="perk-item"><i class="bi bi-check-circle-fill perk-ok"></i> Ad-supported listening</div>
                            <div class="perk-item"><i class="bi bi-x-circle-fill perk-no"></i> HD &amp; Lossless audio</div>
                            <div class="perk-item"><i class="bi bi-x-circle-fill perk-no"></i> Exclusive artist content</div>
                        </div>
                    </div>

                    <!-- Arrow -->
                    <div class="plan-arrow">
                        <div class="arrow-icon"><i class="bi bi-arrow-right"></i></div>
                        <span class="arrow-text">Upgrade</span>
                    </div>

                    <!-- Required plan -->
                    <div class="required-block">
                        <span class="plan-label"><i class="bi bi-lock-fill"></i> Required plan</span>
                        <span class="plan-chip chip-premium required-glow">💎 @requiredPlan</span>
                        <div class="plan-perks">
                            <div class="perk-item"><i class="bi bi-check-circle-fill perk-ok"></i> HD &amp; Lossless audio</div>
                            <div class="perk-item"><i class="bi bi-check-circle-fill perk-ok"></i> Zero ads, ever</div>
                            <div class="perk-item"><i class="bi bi-check-circle-fill perk-ok"></i> Exclusive artist content</div>
                            <div class="perk-item"><i class="bi bi-check-circle-fill perk-ok"></i> Offline downloads</div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Plan Comparison Card -->
            <div class="compare-card">
                <div class="compare-title">
                    <i class="bi bi-grid-3x3-gap"></i> Compare Plans
                </div>

                <div class="plan-cards-grid">

                    <!-- Gold -->
                    <div class="plan-card plan-card-gold">
                        @if (userPlan.Equals("Gold", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="your-badge">Your Plan</span>
                        }
                        <div class="pc-icon pc-icon-gold">🥇</div>
                        <div class="pc-name" style="color:var(--accent-amber);">Gold</div>
                        <div class="pc-price"><strong style="color:var(--accent-amber);">$4.99</strong>/mo</div>
                        <ul class="pc-features">
                            <li><i class="bi bi-check fi-yes"></i> Standard audio</li>
                            <li><i class="bi bi-check fi-yes"></i> Mobile &amp; Desktop</li>
                            <li><i class="bi bi-x fi-no"></i> HD audio</li>
                            <li><i class="bi bi-x fi-no"></i> Offline mode</li>
                            <li><i class="bi bi-lock fi-lock"></i> Exclusive content</li>
                        </ul>
                    </div>

                    <!-- Premium (highlighted) -->
                    <div class="plan-card plan-card-premium">
                        <span class="required-badge">✦ Required</span>
                        <div class="pc-icon pc-icon-premium">💎</div>
                        <div class="pc-name" style="color:var(--accent-gold);">Premium</div>
                        <div class="pc-price"><strong style="color:var(--accent-gold);">$9.99</strong>/mo</div>
                        <ul class="pc-features">
                            <li><i class="bi bi-check fi-yes"></i> HD &amp; Lossless audio</li>
                            <li><i class="bi bi-check fi-yes"></i> No ads</li>
                            <li><i class="bi bi-check fi-yes"></i> Offline downloads</li>
                            <li><i class="bi bi-check fi-yes"></i> Exclusive content</li>
                            <li><i class="bi bi-check fi-yes"></i> Early releases</li>
                        </ul>
                    </div>

                    <!-- Elite -->
                    <div class="plan-card plan-card-elite">
                        @if (userPlan.Equals("Elite", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="your-badge">Your Plan</span>
                        }
                        <div class="pc-icon pc-icon-elite">⚡</div>
                        <div class="pc-name" style="color:var(--accent-cyan);">Elite</div>
                        <div class="pc-price"><strong style="color:var(--accent-cyan);">$17.99</strong>/mo</div>
                        <ul class="pc-features">
                            <li><i class="bi bi-check fi-yes"></i> Everything in Premium</li>
                            <li><i class="bi bi-check fi-yes"></i> 4K concert streams</li>
                            <li><i class="bi bi-check fi-yes"></i> Artist meet &amp; greet</li>
                            <li><i class="bi bi-check fi-yes"></i> Family sharing (6)</li>
                            <li><i class="bi bi-check fi-yes"></i> Priority support</li>
                        </ul>
                    </div>

                </div>
            </div>

            <!-- CTA Buttons -->
            <div class="cta-row">
                <a href="/plans/upgrade" class="btn-upgrade">
                    <i class="bi bi-lightning-charge-fill"></i>
                    Upgrade to @requiredPlan
                    <i class="bi bi-arrow-right btn-arrow"></i>
                </a>
                <a href="javascript:history.back()" class="btn-back">
                    <i class="bi bi-arrow-left"></i>
                    Go Back
                </a>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


